# Optional AI phrasing. All AI features are disabled by default and have
# deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
EVIDENCE_AI_ENABLED=false
MODEL_EXPLANATION_AI_ENABLED=false
SUPPORT_SIGNAL_AI_ENABLED=false

# Evidence cache and tamper-evident audit storage. The optional HMAC key must
# be supplied through the deployment platform's secret manager.
EVIDENCE_GENERATION_VERSION=evidence-v1
EVIDENCE_CACHE_DIR=runtime/evidence_cache
EVIDENCE_CACHE_TTL_SECONDS=21600
EVIDENCE_FALLBACK_CACHE_TTL_SECONDS=300
EVIDENCE_AUDIT_PATH=runtime/evidence_audit.jsonl
EVIDENCE_AUDIT_HMAC_KEY=

# Support-signal cache. No raw support text is persisted here.
SUPPORT_SIGNAL_GENERATION_VERSION=support-signal-service-v1
SUPPORT_SIGNAL_CACHE_DIR=runtime/support_signal_cache
SUPPORT_SIGNAL_CACHE_TTL_SECONDS=86400
SUPPORT_SIGNAL_FALLBACK_CACHE_TTL_SECONDS=300

# Razorpay is opt-in and Test Mode only. Never place Live Mode keys here.
RAZORPAY_INTEGRATION_ENABLED=false
RAZORPAY_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_WEBHOOK_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated exact frontend origins. Wildcards and credential-bearing
# origins are rejected at application startup.
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
